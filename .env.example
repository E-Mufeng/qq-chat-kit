# ============================================================================
#  QQ 聊天机器人 配置模板
#  用法：把本文件复制为 .env，填好下面的值再启动 bot.py
#  （所有项都有默认值，不填也能跑，但 LLM 必须填真实 key 才出回复）
# ============================================================================

# ===== 1. LLM 配置（OpenAI 兼容接口，云端或本地均可）=====
# 云端示例（DeepSeek / OpenAI / 硅基流动 / 月之暗面 等）：
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# 本地模型示例（取消注释改用，需本地起 OpenAI 兼容服务，如 ollama / vllm / lm-studio）：
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 高级（一般不用改）：
LLM_TIMEOUT=90          # 单次 LLM 调用超时（秒）
LLM_MAX_RETRIES=1       # 失败重试次数（LLM 偶发超时建议保持 1，避免双倍延迟）

# ===== 2. 话术与生成行为 =====
GT_STYLE=会撩            # 默认风格：稳健 / 会撩 / 直接
GT_JSON=true             # 强制 LLM 以 JSON 输出（含回复+记忆字段）。
                         # 本地模型若不支持 json_object 改为 false
# 温度在代码内写死 0.8（已在 llm_client.py），如需调整改该文件。

# ===== 3. RAG 本地语料（可选，关掉也不影响运行）=====
GT_RAG=true              # 是否启用本地语料检索（true/false）。
                         # 关掉则只靠 knowledge/ 策略文档 + LLM 自身能力。
GT_RAG_K=6               # 每次检索返回的参考片段数
GT_RAG_CHARS=2000        # 注入 prompt 的语料总字数上限
# 语料根目录（放 corpus.db 的地方）。不填默认 D:\goutou-corpus。
# 想用自己语料时，把 13.4GB 语料按 corpus/fetch_corpus.py + build_index.py 建好索引后，
# 把 GT_CORPUS_ROOT 指到那个目录即可。没建索引时 RAG 自动跳过，不报错。
GT_CORPUS_ROOT=D:\goutou-corpus

# ===== 4. QQ 代聊与安全边界 =====
QQ_AUTO_REPLY=true       # 是否自动回复白名单内私聊（true/false）。
                         # 正式上线前建议先 false，用 /test 调，确认 OK 再开 true。
QQ_AUTO_KUOLIE=true      # 是否自动扩列：收到好友请求自动通过并发送差异化开场白。
QQ_REPLY_DELAY=3         # 每条回复后随机延迟秒数上限，模拟真人手速，降低风控。
QQ_ALLOW_ALL=false       # 危险开关！true = 对所有私聊者代聊。默认 false，必须走白名单。
QQ_WHITELIST=            # 初始白名单（可选，逗号或 JSON 数组，如 1234567890,1111111111）。
                         # 也可运行时用 /allow <QQ号> 动态加。

# ===== 5. NoneBot2 / OneBot v11 配置 =====
HOST=127.0.0.1           # 机器人监听地址（NapCat 反向连接这里）
PORT=8080
ONE_BOT_ACCESS_TOKEN=    # 与 NapCat 约定的 access token，建议设随机串（本发行版默认留空）
SUPERUSERS=["123456789"] # 机器人管理员 QQ 号（用于远程控制 /test /allow /review 等，
                         # 逗号分隔或 JSON 数组）。陌生人发命令一律静默忽略。
